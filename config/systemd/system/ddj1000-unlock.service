[Unit]
Description=DDJ-1000 unlock keepalive (system-wide, headless)
After=sound.target systemd-udevd.service
Wants=ddj1000-audio-rebind.path

[Service]
Type=simple
ExecStart=/usr/local/bin/ddj1000-unlock-service.py --host-stack-scope none --state-file /run/ddj1000/unlocked
Restart=always
RestartSec=2
RuntimeDirectory=ddj1000
Nice=-5

[Install]
WantedBy=multi-user.target
